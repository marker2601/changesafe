# Credential-free replay mode
CHANGESAFE_MODE=replay
CHANGESAFE_DATA_PATH=data/changesafe.db
CHANGESAFE_WEB_DIST=apps/web/dist
CHANGESAFE_SNAPSHOT_PATH=fixtures/datahub/golden-context.json
CHANGESAFE_SNAPSHOT_CHECKSUM_PATH=fixtures/datahub/golden-context.sha256

# Optional live DataHub access
DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN=
# Optional browser-facing catalog origin, such as https://your-company.acryl.io
DATAHUB_UI_URL=
DATAHUB_TIMEOUT_SECONDS=8
DATAHUB_RETRY_COUNT=1
# Keep true for read-only live mode. Deterministic decision writeback requires false.
SAVE_DOCUMENT_RESTRICT_UPDATES=true
DEMO_URN_ALLOWLIST=urn:li:dataset:(urn:li:dataPlatform:dbt,b2fd91.ORDER_ENTRY_DB.analytics.order_details,PROD)
PUBLIC_WRITEBACK_ENABLED=false

# Optional bounded LLM prose and transformation planning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Conservative accounting rates; update when model pricing changes.
OPENAI_INPUT_COST_PER_MILLION_USD=10
OPENAI_OUTPUT_COST_PER_MILLION_USD=60
OPENAI_MAX_INPUT_TOKENS_PER_CALL=16000
OPENAI_MAX_OUTPUT_TOKENS_PER_CALL=1800
CHANGESAFE_LLM_BUDGET_USD=5

# Per-process protection; add an edge limiter for multi-replica deployments.
CHANGESAFE_RUNS_PER_MINUTE=10

# Optional owner-gated GitHub publication
GITHUB_TOKEN=
CHANGESAFE_GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
PUBLIC_PR_ENABLED=false

# Required when either external mutation flag is true
CHANGESAFE_ADMIN_TOKEN=
